          "datasource": {
            "type": "prometheus",
            "uid": "__FALCON_DATASOURCE_UID__"
          },
          "editorMode": "code",
          "expr": "(sum by (node, device) ((max by (instance, device) (rate(node_disk_read_time_seconds_total{job=\"node-exporter\"}[$__rate_interval])) and on (instance, device) (max by (instance, device) (label_replace(label_replace(label_replace(max by (instance, device) (node_disk_filesystem_info{job=\"node-exporter\",type=\"zfs_member\"}), \"member\", \"$1\", \"device\", \"(.+)\"), \"device\", \"$1\", \"device\", \"((sd|hd|vd|xvd)[a-z]+)[0-9]+\"), \"device\", \"$1\", \"device\", \"(.+[0-9])p[0-9]+\")))) * on (instance) group_left (node) (label_replace(max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"$host\"}), \"node\", \"$1\", \"nodename\", \"(.+)\"))) / sum by (node, device) ((max by (instance, device) (rate(node_disk_reads_completed_total{job=\"node-exporter\"}[$__rate_interval])) and on (instance, device) (max by (instance, device) (label_replace(label_replace(label_replace(max by (instance, device) (node_disk_filesystem_info{job=\"node-exporter\",type=\"zfs_member\"}), \"member\", \"$1\", \"device\", \"(.+)\"), \"device\", \"$1\", \"device\", \"((sd|hd|vd|xvd)[a-z]+)[0-9]+\"), \"device\", \"$1\", \"device\", \"(.+[0-9])p[0-9]+\")))) * on (instance) group_left (node) (label_replace(max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"$host\"}), \"node\", \"$1\", \"nodename\", \"(.+)\")))) and (sum by (node, device) ((max by (instance, device) (rate(node_disk_reads_completed_total{job=\"node-exporter\"}[$__rate_interval])) and on (instance, device) (max by (instance, device) (label_replace(label_replace(label_replace(max by (instance, device) (node_disk_filesystem_info{job=\"node-exporter\",type=\"zfs_member\"}), \"member\", \"$1\", \"device\", \"(.+)\"), \"device\", \"$1\", \"device\", \"((sd|hd|vd|xvd)[a-z]+)[0-9]+\"), \"device\", \"$1\", \"device\", \"(.+[0-9])p[0-9]+\")))) * on (instance) group_left (node) (label_replace(max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"$host\"}), \"node\", \"$1\", \"nodename\", \"(.+)\"))) > 0)",
          "legendFormat": "{{node}} / {{device}}",
          "range": true,
          "refId": "A"
        }
      ],
