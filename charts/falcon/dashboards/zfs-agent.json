  "description": "Logical dataset I/O and ARC across selected hosts, plus individual ZFS backing-disk read/write latency. Disk panels never aggregate across devices or hosts. Each whole disk is identified using node-exporter udev member metadata.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "__FALCON_DATASOURCE_UID__"
      },
      "description": "Whole block devices backing ZFS. Discover member signatures via udev and map sd/hd/vd/xvd and NVMe/MMC/MD partitions to their parent disk. Deduplicate parents before joining I/O counters. Shared disks include non-ZFS traffic; dedicated ZFS disks are assumed.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "min": 0,
          "noValue": "N/A",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "__FALCON_DATASOURCE_UID__"
          },
          "editorMode": "code",
          "expr": "count((max by (instance, device) (label_replace(label_replace(label_replace(max by (instance, device) (node_disk_filesystem_info{job=\"node-exporter\",type=\"zfs_member\"}), \"member\", \"$1\", \"device\", \"(.+)\"), \"device\", \"$1\", \"device\", \"((sd|hd|vd|xvd)[a-z]+)[0-9]+\"), \"device\", \"$1\", \"device\", \"(.+[0-9])p[0-9]+\"))) * on (instance) group_left (node) (label_replace(max by (instance, nodename) (node_uname_info{job=\"node-exporter\",nodename=~\"$host\"}), \"node\", \"$1\", \"nodename\", \"(.+)\")))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "ZFS disks",
      "type": "stat"
    },
